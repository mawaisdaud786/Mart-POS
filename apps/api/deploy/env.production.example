# RetailOS API settings for cPanel.
# Put these in cPanel > Setup Node.js App > Environment variables (preferred),
# or copy this file to ".env" next to server.js and run: chmod 600 .env
# Never share, email or commit the real values.

NODE_ENV=production

# Database created in cPanel > MySQL Databases. Use a dedicated user with access to this one database only
# (never "root"). If the password contains @ : / # ? or %, URL-encode it (for example @ becomes %40).
DATABASE_URL=mysql://cpaneluser_retailos:PASSWORD@localhost:3306/cpaneluser_retailos

# Generate both with:  node cli.js gen-secrets
JWT_PRIVATE_KEY=
APP_ENCRYPTION_KEY=

# The exact address(es) your web app is opened from. https only, no trailing slash, no wildcards.
CORS_ORIGINS=https://shop.example.com

# Optional. Defaults shown. Cookies are always HTTPS-only in production.
# TRUST_PROXY=1            # cPanel's Apache is one proxy in front of Node. Use 2 if you also use Cloudflare.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# LOG_LEVEL=info
# DB_COLLATION=utf8mb4_unicode_ci   # leave unset; only change if your host tells you to
