# Copy to .env and fill in. Never commit .env.
DATABASE_URL=mysql://retailos_app:CHANGE_ME@127.0.0.1:3307/retailos
TEST_DATABASE_URL=mysql://retailos_app:CHANGE_ME@127.0.0.1:3307/retailos_test
MYSQL_ROOT_PASSWORD=
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
KEYS_DIR=storage/keys
# Production only (generated automatically into KEYS_DIR in development):
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APP_ENCRYPTION_KEY=<32 random bytes, base64>
# COOKIE_SECURE=true
# First tenant owner login created by `pnpm db:seed` (development)
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@alnoormart.test
SEED_OWNER_PASSWORD=

# Production on cPanel: see docs/deployment-cpanel.md and apps/api/deploy/env.production.example.
# Optional in development (defaults: secure cookies and 1 proxy hop only when NODE_ENV=production):
# COOKIE_SECURE=true
# TRUST_PROXY=0
# DB_COLLATION=utf8mb4_unicode_ci
