{
  "name": "retailos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present --filter '!@retailos/desktop' run build",
    "dev": "corepack pnpm --filter @retailos/api --filter @retailos/web --parallel run dev",
    "desktop:dev": "corepack pnpm --dir apps/desktop dev",
    "desktop:build": "corepack pnpm --dir apps/desktop build",
    "desktop:package": "corepack pnpm --dir apps/desktop package",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "corepack pnpm -r --if-present run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
